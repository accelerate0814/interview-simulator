DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Embeddings (optional) ───────────────────────────────────────────
# Used only for cross-session question de-dup once a client's history grows
# past ~50 questions. Leave EMBEDDING_API_KEY empty to disable — de-dup then
# falls back to a recency-based list, everything else keeps working.
#
# Most chat providers (DeepSeek, Moonshot, OpenRouter) have NO embeddings
# endpoint, so this is configured separately. Defaults target OpenAI.
#   - OpenAI:    base_url https://api.openai.com/v1   model text-embedding-3-small
#   - 通义/DashScope: base_url https://dashscope.aliyuncs.com/compatible-mode/v1  model text-embedding-v3
#   - 智谱:      base_url https://open.bigmodel.cn/api/paas/v4   model embedding-3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ── Voice input: 火山引擎 流式语音识别大模型 SAUC ─────────────────
# The mic button captures 16k mono PCM in the browser and streams it over the
# /api/asr-stream WebSocket; the backend relays it to Volcengine SAUC's streaming
# endpoint, pushes interim transcripts back live, then cleans the final text up
# with the chat model (⚙️ 模型配置 / DEEPSEEK_API_KEY). No ffmpeg needed.
# Leave the keys empty to disable voice input (the mic button hides itself).
#
# Two auth styles — set ONE:
#   新版控制台 (推荐):  VOLC_ASR_API_KEY   —— 语音技术控制台的 API Key (UUID)
#   老版控制台:         VOLC_ASR_APP_KEY + VOLC_ASR_ACCESS_KEY
# 需先在「语音技术控制台」开通【流式语音识别大模型 / Seed-ASR】，
# 并以那个服务页「调用示例」里的 resource_id 为准（前缀可能是
# volc.seedasr.* 或 volc.bigasr.*）。
VOLC_ASR_API_KEY=
VOLC_ASR_APP_KEY=
VOLC_ASR_ACCESS_KEY=
# 计费方式：按时长 ....sauc.duration / 按并发 ....sauc.concurrent
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
